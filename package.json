{
  "name": "website-cms",
  "description": "A blank template to get started with Payload",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:graphQLSchema": "cross-env NODE_OPTIONS=--no-deprecation payload generate:graphQLSchema",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "^3.92.1",
    "@payloadcms/next": "^3.92.1",
    "@payloadcms/payload-cloud": "^3.92.1",
    "@payloadcms/richtext-lexical": "^3.92.1",
    "@payloadcms/ui": "^3.92.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.0",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "^3.92.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "^3.5.1",
    "typescript": "^5.0.0"
  }
}
